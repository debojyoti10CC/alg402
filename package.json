{
  "name": "ward",
  "version": "0.1.0",
  "description": "Verifies whether an x402 payment facilitator on Algorand actually honors its correctness invariants, via adversarial tests against a real self-hosted facilitator.",
  "type": "module",
  "bin": {
    "ward": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "ward": "tsx src/cli/index.ts",
    "server": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "10.0.0-alpha.46",
    "@x402/avm": "^2.22.0",
    "@x402/core": "^2.22.0",
    "@x402/express": "^2.22.0",
    "@x402/extensions": "^2.22.0",
    "@x402/fetch": "^2.22.0",
    "algosdk": "^3.5.2",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.5"
  }
}
