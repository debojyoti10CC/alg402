# Generate every key below with: npx tsx scripts/fund-accounts.ts
# Then follow the manual funding steps it prints (dispensers are captcha-gated,
# so nothing here can be automated end-to-end — see DECISIONS.md D9).

# --- Ward CLI (the host-side test harness) ---
FACILITATOR_URL=http://localhost:4022
WARD_NETWORK=testnet
ALGOD_TESTNET_URL=https://testnet-api.algonode.cloud
ALGOD_TOKEN=
USDC_ASSET_ID=10458941

# Base64 algosdk secret key (32-byte seed + 32-byte pubkey) for the account Ward
# signs test payments from.
WARD_CLIENT_PRIVATE_KEY=

# The seller/resource-owner stand-in Ward pays. Needs its own base64 key only if
# you want Ward to opt it into the test ASA for you (WARD_PAYTO_PRIVATE_KEY);
# the address alone is enough for it to just receive payments.
WARD_PAYTO_ADDRESS=
WARD_PAYTO_PRIVATE_KEY=

# Funds WARD_CLIENT / disposable A3 accounts with native ALGO via `ward init`.
# Omit to skip auto-funding and fund those addresses by hand instead.
WARD_FUNDER_PRIVATE_KEY=

# --- Self-hosted facilitator (docker-compose.yml) ---
# The facilitator's own fee-payer signing key. Needs its own TestNet ALGO balance
# to co-sign settlement fee-payer transactions.
AVM_PRIVATE_KEY=
ALGOD_SERVER=https://testnet-api.algonode.cloud

# Required by the upstream facilitator example to start (it's a multi-chain
# service) but never exercised by Ward — any well-formed throwaway value works.
# `fund-accounts.ts` generates these for you.
EVM_PRIVATE_KEY=
SVM_PRIVATE_KEY=

# --- Paid verification server (src/server) ---
# Receives x402 payments for POST /verify-facilitator. Separate from the
# WARD_* test-harness accounts above on purpose — this is service revenue,
# not test fixtures. Never needs pre-funding; it only receives.
SERVER_PAY_TO_ADDRESS=
SERVER_PORT=4030
